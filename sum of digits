import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
    Scanner x =new Scanner(System.in);
        int n = x.nextInt();
        int c = 0;
        while(n!=0){
            int t = n%10;
            c+=t;
            n=n/10;
            
        }
        if(c>0)
        System.out.println(c);
        else
               System.out.println(-c);        
 
        
    }
}
