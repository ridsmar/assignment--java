
import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
      Scanner x = new Scanner(System.in);
    int n = x.nextInt();
       for(int i =n-1; i>=0 ;i--){
           for(int j = 0;j<=i;j++){
               System.out.print("*");
           }
            System.out.println();
       } 
    }
}
