import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
        Scanner x= new Scanner(System.in);
        int c=0;
        int n = x.nextInt();
        for(int i =1;i<=n;i++){
            if(n%i ==0){
                c++;
            }
            }
           System.out.print(c);
        }
         
    }
