import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
        Scanner x =new Scanner(System.in);
        int n = x.nextInt();
        for(int i =1; i<=n;i++){
            System.out.print(i+" ");
        }
        for( int i =n; i>=1;i--){
            System.out.print(i+" ");
        }
    }
}
