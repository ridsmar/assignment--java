import java.util.Scanner;

public class Solution {
    public static void main(String[] args) {
        Scanner x = new Scanner(System.in);
        int n = x.nextInt();   
        int c = 0;
        if (n < 0) {
            n = -n;
        }
        if (n == 0) {
            System.out.println(1);
            return;
        }
        int t = n;
        
        while (t > 0) {
            t = t / 10;  
            c++;           
        }
        
        System.out.println(c);
    }
}
