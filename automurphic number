import java.util.Scanner;

public class Solution {
    public static void main(String[] args) {
        Scanner x = new Scanner(System.in);
        int n = x.nextInt();
        int s = n * n;
       int t = n;
        int c = 0;
        while (t > 0) {
            t /= 10;
            c++;
        }
        int d = 1;
        for (int i = 1; i <= c; i++) {
            d *= 10;
        }
        if (s % d == n) {
            System.out.println("Automorphic");
        } else {
            System.out.println("Not Automorphic");
        }
    }
}
