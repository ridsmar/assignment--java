
import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
        Scanner x= new Scanner(System.in);
        int n = x.nextInt();
        int c = 0;
        int v = 1;
        for(int i =1; i<=n;i++){
            c = c + i;
            v = v*i;
        }
            System.out.println(c);
        
            System.out.println(v);
        
        
    }
    
}
