import java.util.Scanner;

public class Solution {
    public static int power(int b, int e) {
        int r = 1;
        for (int i = 1; i <= e; i++) {
            r *= b;
        }
        return r;
    }

    public static void main(String[] args) {
        Scanner x = new Scanner(System.in);
        int n = x.nextInt();
        int c = 0;
        int t = n;
    
            while (t != 0) {
                t /= 10;
                c++;
            }
        

        
        int z = n;
        int s = 0;
              
                while (z > 0) {
                int d = z % 10;
                s += power(d, c);
                z /= 10;
            }
        

   
        if (s == n) {
            System.out.println("true");
        } else {
            System.out.println("false");
        }
    }
}
