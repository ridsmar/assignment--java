import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
        Scanner x = new Scanner(System.in);
        int n = x.nextInt();
        int c = 0;
        for(int i =1;i<n;i++){
            if(n%i == 0){
                c= c+i;
                
            }
  
        }
        if(c==n)
            System.out.println("Perfect Number");

        else
            System.out.println("Not a Perfect Number");
    }
}
