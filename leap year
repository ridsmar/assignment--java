import java.util.Scanner;
public class Solution {
    public static void main(String[] args) {
        Scanner x = new Scanner(System.in);
        int y = x.nextInt();
        if(y%400 == 0){
            System.out.println("Leap Year");
        }else if(y%4 ==0 && y%100!=0) {
             System.out.println("Leap Year");
        }else{
            System.out.println("Not a Leap Year");
        }
    }
}
