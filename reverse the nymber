import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
        Scanner x= new Scanner(System.in);
        int n = x.nextInt();;
        int v = 0;
        while(n!=0){
            int t =n%10;
            v =(v*10)+t;
            n = n/10;
        }
        System.out.print(v);           
    }
}
