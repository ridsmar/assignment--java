import java.util.Scanner;

public class Solution {
    public static void main(String[] args) {
        Scanner x = new Scanner(System.in);
        int n = x.nextInt();
        int s = n * n;
        int r = 0;

        
        while (s != 0) {
            r += s % 10;
            s/= 10;
        }

        if (r == n) {
            System.out.println("true");
        } else {
            System.out.println("false");
        }
    }
}
