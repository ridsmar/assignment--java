import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
      Scanner x = new Scanner(System.in);
        int n = x.nextInt();
        int c =0;
        int b =9;
        if ( n<0){
            n =  (-1)*n;
        }
        if(n==0)
        { 
            b = 0;
        }
        while(n!=0){
            int t = n%10;
            if(t>c){
                c=t;
            }
            if(t<b){
                b=t;
            }
              n/=10;
        }
            System.out.print(c+" ");
            System.out.print(b);                          
        }
    
    }
    
    
