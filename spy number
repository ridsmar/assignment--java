import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
      Scanner x = new Scanner(System.in);
        int n = x.nextInt();
        int c = 0;
        int v = 1;
        while( n!=0){
            int t = n%10;
            c=c+t;
            v=v*t;
            n=n/10;
        }
        if(c==v)
             System.out.println("Spy Number");
        else        
             System.out.println("Not a Spy Number");
         
     
    }
}
