import java.util.Scanner;

public class Solution {
    public static void main(String[] args) {
        Scanner x = new Scanner(System.in);
        int n = x.nextInt();
        int t = n;
        int s = 0;
        while (t != 0) {
            s += t % 10;
            t /= 10;
        }
        if (n % s == 0) {
            System.out.println("Harshad Number");
        } else {
            System.out.println("Not Harshad Number");
        }
    }
}
