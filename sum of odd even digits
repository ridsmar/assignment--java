import java.util.Scanner;

public class Solution {

    public static void main(String[] args) {
      Scanner x= new Scanner(System.in);
        int n = x.nextInt();
        int e = 0;
        int o = 0;
        while(n!=0){
            int t = n%10;
            if(t> 0){
            if(t%2 ==0)
            e = e+t;
            else 
                o = o+t;
            }
            if(t<0){
                t = t*(-1);
            if(t%2 ==0)
            e = e+t;
            else 
                o = o+t;
            }
            n = n/10;
        }
        System.out.print(o+" ");
        System.out.print(e);
    }
}
